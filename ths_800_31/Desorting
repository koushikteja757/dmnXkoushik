#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int>v(n);
        for(int i=0;i<n;i++){
            cin>>v[i];
        }

        vector<int> vec;
        for(int i=0;i<n-1;i++){
            vec.push_back(v[i+1]-v[i]);
        }

        sort(vec.begin(),vec.end());

        if(vec[0]<0)
            cout<<0<<endl;
        else
            cout<<(vec[0]/2)+1<<endl;
}
}