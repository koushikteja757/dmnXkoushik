#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin >> t;
    while(t--)
    {
        int a, b;
        cin >> a >> b;
        int mx = 0;
        vector<int> v(a);
        for(int i = 0; i < a; i++)
            cin >> v[i];
        
        v.push_back(0);
        
        sort(v.begin(), v.end());
        
        for(int i = 1; i < v.size(); i++)
        {
            mx = max(mx, v[i] - v[i-1]);
        }
        mx = max(mx, 2 * (b - v[a]));
        cout << mx << endl;
    }
}