#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;

        vector<int> v;
        set<int> s;

        for(int i=0;i<n;i++)
        {
            int a;
            cin>>a;
            v.push_back(a);
            s.insert(a);
        }

        if(s.size()==1)
        {
            cout<<"YES"<<endl;
        }

        else if(s.size()==2)
        {
            int d1=0,d2=0;

            for(int i=0;i<n;i++)
            {
                if(v[0]==v[i])
                    d1++;
                else
                    d2++;
            }

            if(max(d1,d2)-min(d1,d2)<=1)
            {
                cout<<"YES"<<endl;
            }
            else
            {
                cout<<"NO"<<endl;
            }
        }

        else
        {
            cout<<"NO"<<endl;
        }
        
    }
}