#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int> v(n);
        for(int i=0;i<n;i++)
            cin>>v[i];

        int p=0;
        int m=0;
        
        for(int i=0;i<n;i++)
        {
            if(v[i]==1)
                p++;
            else
                m++;
        }

        int c=0;

        
        while((m > p) || (m % 2 == 1))
        { 
            c++;
            m--;
            p++; 
        }
        cout<<c<<endl;
    }
}