#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int>v(n);
        for(int i=0;i<n;i++)
            cin>>v[i];
        
        int h=0;
        int c=0;
        for(int i=0;i<n;i++)
        {
            if( v[i]==0 )
            {
                h++;
                c=max(c,h);
            }
            else
            {
                h=0;
            }
        }
        cout<<c<<endl;
    }
}