#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,b,a;
        cin>>n>>a>>b;
        if(a==n && n==b)
            cout<<"YES"<<endl;
        else if(n-(a+b)>=2)
            cout<<"YES"<<endl;
        else
            cout<<"NO"<<endl;
    }
}