#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int> v(n);
        for(int i=0;i<n;i++)
            cin>>v[i];

        vector<int> vec;

        for(int i=0;i<n;i++)
        {
            if(i%2==0)
            vec.push_back('R');
            else
            vec.push_back('B');
        }

        map<int,char> m;

        for(int i=0;i<n;i++)
        {
            if(i%2==0)
            {
                m[v[i]]='R';
            }
            else
            {
                m[v[i]]='B';
            }  
        }


        sort(v.begin(),v.end());

        int h=0;
        for(int i=0;i<n;i++)
        {
            if(m[v[i]]==m[v[i-1]])
            {
                h=1;
                break;
            }
        }
        if(h==1)
        cout<<"NO"<<endl;

        else
        cout<<"YES"<<endl;


    }
}
