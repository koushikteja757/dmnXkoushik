#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int> v(n);
        int tc=0;
        int two=0;
        for(int i=0;i<n;i++)
        {
            cin>>v[i];
            if(v[i]==2)
            tc++;
        }
            
        if(tc==0)
            cout<<1<<endl;
        else if(tc%2!=0)
            cout<<-1<<endl;
        else if(tc==n)
            cout<<n/2<<endl;
        else
        {
            for(int i=0;i<n;i++)
            {
                if(v[i]==2)
                    two++;
                if(two==tc/2){
                    cout<<i+1<<endl;
                    break;
                }
            }
        }
    }
}