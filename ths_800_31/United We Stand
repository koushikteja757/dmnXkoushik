#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int> v(n);
        for(int i=0;i<n;i++)
            cin>>v[i];
        
        vector<int> b,c;

        sort(v.begin(),v.end());

        for(int i=0;i<n;i++)
        {
            if(v[0]==v[i])
            {
                b.push_back(v[i]);
            }

            else
            {
                c.push_back(v[i]);
            }
        }
        if(c.size()==0)
        {
        cout<<-1<<endl;
        }
        else
        {
            cout<<b.size()<<" "<<c.size()<<endl;
            for(int i=0;i<b.size();i++)
            {
                cout<<b[i]<<" ";
            }
            cout<<endl;
            for(int i=0;i<c.size();i++)
            {
                cout<<c[i]<<" ";
            }
        }
    }
}