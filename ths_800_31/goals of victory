#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int> v(n-1);

        for(int i=0;i<n-1;i++)
            cin>>v[i];

        int c1=0;
        int c2=0;

        for(int i=0;i<n-1;i++)
        {
            if(v[i]>0)
            {
                c1+=v[i];
            }
            else
                c2 = c2 + -(v[i]);
        }

        cout<<c2-c1<<endl;
        
    }
}