#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin>>t;
    while(t--)
    {

        int count=0;
        int a,b;
        cin>>a>>b;
        vector<int> v(a);
        for(int i=0;i<a;i++)
            cin>>v[i];
        for(int i=0;i<a;i++)
        {
            if(b==v[i])
            count=1;
        }
        if(count==1)
        cout<<"YES"<<endl;
        else
        cout<<"NO"<<endl;
    }

}