#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int>v(n);
        int h=0;
        for(int i=0;i<n;i++)
            cin>>v[i];
        
        for(int i=0;i<n;i++)
        {
            h=max(h,v[i]); 
        }
        h++;

        for(int i=0;i<n;i++)
        {
            cout<<h-v[i]<<" ";
        }
        cout<<endl;
    }
}