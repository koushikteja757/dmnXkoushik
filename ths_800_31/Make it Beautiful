#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while(t--) {
        int n;
        cin >> n;
        vector<int> v(n);
        for(int i = 0; i < n; i++)
            cin >> v[i];
            
        sort(v.begin(), v.end());
        reverse(v.begin(), v.end());
        
        if(v[0] == v[1]) {
          for(int i = 2; i < n; i++) {
           if(v[i] != v[0]) {
              swap(v[1], v[i]);
                 break;
           }
         }
        }
        
        int c = 0;
        int f = 0;
        for(int i = 0; i < n - 1; i++) {
            if(c + v[i] != v[i+1]) {
                c += v[i];
            } else {
                f = 1;
                break;
            }
        }
        
        if(f == 0) {
            cout << "YES" << endl;
            for(int i = 0; i < n; i++) {
                cout << v[i] << " ";
            }
            cout << endl;
        } else {
            cout << "NO" << endl;
        }
    }
    return 0;
}