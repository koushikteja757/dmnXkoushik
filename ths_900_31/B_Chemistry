#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,k;
        cin>>n>>k;

        string s;
        cin>>s;

        sort(s.begin(),s.end());
        map<char,int> m;

        int c=0;
        for(int i=0;i<n;i++)
        {
            m[s[i]]++;
        }

        for(char i='a';i<='z';i++)
        {
            if(m[i]%2==1)
            {
               c++;
            }

        }

        if(c - 1 <= k)
        cout<<"YES"<<endl;
        else
        cout<<"NO"<<endl;

    }
}