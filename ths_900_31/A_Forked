#include <bits/stdc++.h>
using namespace std;

    int dx[4]={1,-1,1,-1};
    int dy[4]={1,-1,-1,1};
int main() 
{
    int t;
    cin>>t;
    while (t--)
    {
        int a,b;
        cin>>a>>b;
        int kx,ky,qx,qy;
        cin>>kx>>ky>>qx>>qy;
        
        set<pair<int,int>> qs;
        set<pair<int,int>> ks;

        for(int i=0;i<4;i++)
        {
            ks.insert({( kx + dx[i]*a) , ( ky + dy[i]*b)} );
            ks.insert({( kx + dx[i]*b) , ( ky + dy[i]*a)} );

            qs.insert({( qx + dx[i]*a) , ( qy + dy[i]*b)});
            qs.insert({( qx + dx[i]*b) , ( qy + dy[i]*a)});

        }
        
        int c=0;
        for(auto p:ks)
        {
            if(qs.find(p) != qs.end())
                c++;
        }
        cout<<c<<endl;

    }
    
}