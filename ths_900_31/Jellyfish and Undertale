#include <bits/stdc++.h>
using namespace std;

#define ll long long int

int main() 
{
    ll t;
    cin>>t;
    while(t--)
    {
        ll a,b,n;
        cin>>a>>b>>n;                           
        ll cnt=b;
        for (int i = 0; i < n; i++) 
        {
            ll x;
            cin>>x;
            cnt+=min(a-1,x);
        }
        cout<<cnt<<endl;
    }
}
